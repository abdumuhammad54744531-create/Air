APP_NAME="Sistem Informasi Monitoring dan Manajemen Air"
# Lokal: APP_ENV=local dan APP_DEBUG=true. Domain/hosting: production dan false.
APP_ENV=local
APP_DEBUG=true
# Kosongkan untuk mendeteksi domain otomatis, atau isi misalnya https://domain-anda.com
APP_URL=
APP_TIMEZONE=Asia/Makassar
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=monitoring_air
DB_USERNAME=root
DB_PASSWORD=
PUBLIC_PAGE_ENABLED=true
DEVICE_OFFLINE_MINUTES=15
DASHBOARD_REFRESH_SECONDS=30
SESSION_TIMEOUT_MINUTES=120
APP_ALLOW_REINSTALL=false
# Windows memakai tools/epanet/runepanet.exe. Server Linux memakai binary ARM hasil build EPANET.
EPANET_BIN=
EPANET_LIBRARY_PATH=/usr/local/lib
